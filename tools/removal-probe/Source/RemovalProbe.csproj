<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RemovalProbe</AssemblyName>
    <RootNamespace>RemovalProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin/Release</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The game install, found as for the mod itself (RIMWORLD_DIR, else the nearest folder above that holds Assembly-CSharp.dll or a RimWorld/ folder that does). -->
    <RimWorldDir Condition="'$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Assembly-CSharp.dll'))</RimWorldDir>
    <RimWorldParent Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'RimWorld/Assembly-CSharp.dll'))</RimWorldParent>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RimWorldParent)' != ''">$(RimWorldParent)/RimWorld</RimWorldDir>
    <ManagedDir>$(RimWorldDir)</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(ManagedDir)/UnityStubs.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)/RemovalProbe.dll" DestinationFolder="$(ProjectDir)../Assemblies/" />
  </Target>
</Project>
